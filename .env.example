# WordSwipe — required environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# Backend API URL (set as EAS Secret for production builds)
EXPO_PUBLIC_API_URL=https://api.example.com

# OpenAI — used by the Express backend for sentence analysis
OPENAI_API_KEY=sk-...

# DeepL — used by the Express backend for translation (optional: 503 if missing)
DEEPL_API_KEY=...

# Express server port (local dev only)
PORT=8787

# AdMob App IDs (set as EAS Secrets for production builds)
# Format: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
ADMOB_APP_ID_IOS=ca-app-pub-...
ADMOB_APP_ID_ANDROID=ca-app-pub-...
